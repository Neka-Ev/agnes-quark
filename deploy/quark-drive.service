[Unit]
Description=Quark Drive headless download server
Documentation=https://github.com/Neka-Ev/agnes-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quark
Group=quark
EnvironmentFile=-/etc/quark-drive.env
ExecStart=/usr/local/bin/quark-server \
  --listen 127.0.0.1:8787 \
  --data-dir /var/lib/quark-drive \
  --download-root /srv/quark-downloads \
  --concurrency 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quark-drive /srv/quark-downloads

[Install]
WantedBy=multi-user.target
